# Zugangsdaten – Datei als .env kopieren und ausfüllen. .env niemals committen!
# Home Assistant für den Novelan-LADV9-Adapter
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# Entity-IDs aus Home Assistant; alle Sensoren sind optional.
# NOVELAN_ENTITY_AUSSEN_C=sensor.novelan_aussentemperatur
# NOVELAN_ENTITY_VORLAUF_C=sensor.novelan_vorlauftemperatur
# NOVELAN_ENTITY_RUECKLAUF_C=sensor.novelan_ruecklauftemperatur
# NOVELAN_ENTITY_VERDICHTER_AN=binary_sensor.novelan_verdichter
# NOVELAN_ENTITY_VERDICHTER_HZ=sensor.novelan_verdichterfrequenz
# NOVELAN_ENTITY_LEISTUNG_W=sensor.novelan_elektrische_leistung
# NOVELAN_ENTITY_STROM_KWH=sensor.novelan_stromverbrauch
# NOVELAN_ENTITY_WAERME_KWH=sensor.novelan_waermeertrag
# NOVELAN_ENTITY_HEIZSTAB_AN=binary_sensor.novelan_heizstab
# NOVELAN_ENTITY_BETRIEBSART=sensor.novelan_betriebsart
# NOVELAN_ENTITY_WARMWASSER_C=sensor.novelan_warmwassertemperatur
# NOVELAN_ENTITY_STOERUNG=sensor.novelan_stoerung
# NTFY_TOPIC=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
